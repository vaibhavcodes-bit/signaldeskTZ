generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             String   @id @default(cuid())
  name           String
  websiteUrl     String   @unique
  description    String?
  industry       String?
  location       String?
  employeeCount  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([industry])
}