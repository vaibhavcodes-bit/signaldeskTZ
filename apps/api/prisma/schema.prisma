generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id            String  @id @default(cuid())
  name          String
  websiteUrl    String
  description   String
  industry      String
  employeeCount Int?
  location      String?

  intelligence CompanyIntelligence?
  aiUsages     AIUsage[]
  signals      OpportunitySignal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyIntelligence {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  summary       String
  industry      String
  businessModel String

  targetCustomers        Json
  productsOrServices     Json
  technologies           Json
  growthSignals          Json
  potentialOpportunities Json

  confidence Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIUsage {
  id        String @id @default(cuid())
  companyId String

  provider String
  model    String

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)

  estimatedCost Float @default(0)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model OpportunitySignal {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type        String
  title       String
  description String

  strength   Float
  confidence Float

  evidence Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([type])
  @@index([createdAt])
}
